{
  "$schema": "https://tauri.app/schema.json",
  "package": {
    "productName": "Dexteri++",
    "version": "0.1.0"
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5174",
    "distDir": "frontend/domain-watcher-box/dist",
    "withGlobalTauri": true
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "shell": {
        "open": true
      }
    },
    "windows": [
      {
        "title": "Dexteri++",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.dexteri.app",
      "icon": [
        "icons/icon.png"
      ]
    },
    "security": {
      "csp": "default-src 'self' data: blob: 'unsafe-inline' 'unsafe-eval'"
    }
  }
}
